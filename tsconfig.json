{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2023", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
		"types": ["node", "vite/client", "bun"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"noUnusedLocals": true,
		"noFallthroughCasesInSwitch": false
	},
	"include": ["src", "tools", "tests"]
}
